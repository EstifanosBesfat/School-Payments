# Copy to apps/web/.env.local
# Server-side URL the Next.js server uses to reach the API.
API_URL=http://localhost:4000
# Public site URL (used in links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Receipt public keys baked into the verifier so it works without the API: JSON {"keyId":"base64urlKey"}.
NEXT_PUBLIC_RECEIPT_PUBLIC_KEYS={"dev-2026-10":"paste RECEIPT_SIGNING_PUBLIC_KEY here"}
