# Copy to .env at the repository root. apps/api and packages/db both read this file.
NODE_ENV=development

# --- URLs ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# HTTP API process: set false in production and run `node dist/worker.js` as a separate process.
RUN_WORKERS=true

# --- Database ---
# The API connects as the least-privileged role so Row-Level Security applies.
DATABASE_URL=postgresql://payment_app:payment_app_dev_password@localhost:5436/payment
# Migrations run as the table owner.
MIGRATION_DATABASE_URL=postgresql://payment_owner:payment_owner_dev_password@localhost:5436/payment

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6380

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# 32 random bytes, base64. Encrypts per-school secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# --- Receipt signing (Ed25519) ---
# Run `pnpm keys:generate` and paste the output here.
RECEIPT_SIGNING_KEY_ID=
RECEIPT_SIGNING_PRIVATE_KEY=
RECEIPT_SIGNING_PUBLIC_KEY=

# --- Payment gateway ---
# "mock" simulates Chapa locally (no keys needed). Use "chapa" with test keys from the Chapa dashboard.
PAYMENT_GATEWAY=mock
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Platform commission taken through Chapa split payments.
PLATFORM_FEE_TYPE=percentage
PLATFORM_FEE_VALUE=0.02

# --- SMS ---
# console | afromessage | geezsms
SMS_PROVIDER=console
SMS_FALLBACK_PROVIDER=
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=
GEEZSMS_TOKEN=
GEEZSMS_SHORTCODE_ID=

# --- Email (Mailpit in docker-compose catches all mail at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="School Payments <no-reply@example.com>"

# --- Receipt PDF storage ---
# local (development) | s3 (Cloudflare R2, AWS S3 or any S3-compatible store in production)
STORAGE_DRIVER=local
# R2 example: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=receipts
S3_ACCESS_KEY=
S3_SECRET_KEY=
LOCAL_STORAGE_DIR=./storage

# --- Seed data ---
SEED_PLATFORM_ADMIN_EMAIL=admin@platform.local
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe!2026
